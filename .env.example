# WorkforceIQ environment configuration.
#
# Copy this file to `.env.local` and fill in real values to enable live
# Supabase and Gemini integrations. The app runs without any of these set;
# features render honest "not configured" placeholder states instead.

# --- Supabase (database + auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: service role key for server-side privileged access. Never expose
# this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (free-tier model, e.g. gemini-2.0-flash) ---
GEMINI_API_KEY=