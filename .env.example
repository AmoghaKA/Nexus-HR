# Nexus HR environment configuration.
#
# Copy this file to `.env.local` and fill in real values to enable live
# Supabase and AI integrations. The app runs without any of these set;
# features render honest "not configured" placeholder states instead.

# --- Supabase (database + auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: service role key for server-side privileged access and the
# `npm run seed` demo-user script. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI providers (multi-provider failover)
#
# Qwen (via Alibaba Cloud Model Studio / DashScope) is the PRIMARY AI engine
# used for reasoning, content generation, and decision-making. The AI router
# tries Qwen first and automatically falls back to the next provider when Qwen
# is unavailable (free-tier rate limit, timeout, rejected key, dead endpoint).
# A provider is only used when its API key is set here — entries left blank are
# skipped entirely. `npm run dev` health check reports which providers are on.
# ---------------------------------------------------------------------------

# --- Qwen / DashScope (primary AI engine; qwen-max → qwen-plus → qwen-turbo) ---
# Get a key at Alibaba Cloud Model Studio: https://dashscope.console.aliyun.com
QWEN_API_KEY=
# Optional: override the DashScope OpenAI-compatible endpoint.
# Default: https://dashscope.aliyuncs.com/compatible-mode/v1
# US region: https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
# Optional: pin a specific Qwen model (e.g. qwen3.8-max). Default: qwen-max.
QWEN_MODEL=

# --- Google Gemini (automatic failover fallback after Qwen) ---
GEMINI_API_KEY=

# --- OpenRouter (free models, text-only, auto-fallback list is built in) ---
OPENROUTER_API_KEY=

# --- Groq (free tier: openai/gpt-oss-120b etc., auto-fallback list is built in) ---
GROQ_API_KEY=

# --- Mistral (free tier: mistral-small-latest etc., auto-fallback list is built in) ---
MISTRAL_API_KEY=

# --- Router behavior ---
# Priority in which to try providers. Comma-separated; unconfigured ones are skipped.
# Default: qwen,gemini,openrouter,groq,mistral
AI_PROVIDER_ORDER=qwen,gemini,openrouter,groq,mistral
# How long (ms) a provider is skipped after an outage-class failure (default 5000).
AI_PROVIDER_COOLDOWN_MS=5000