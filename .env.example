# WorkforceIQ environment configuration.
#
# Copy this file to `.env.local` and fill in real values to enable live
# Supabase and AI integrations. The app runs without any of these set;
# features render honest "not configured" placeholder states instead.

# --- Supabase (database + auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: service role key for server-side privileged access and the
# `npm run seed` demo-user script. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI providers (multi-provider failover)
#
# The AI router tries the first *configured* provider in `AI_PROVIDER_ORDER`
# and automatically falls back to the next one when a provider is unavailable
# (free-tier rate limit, timeout, unreachable endpoint, rejected key). A
# provider is only used when its API key is set here — entries left blank are
# skipped entirely. `npm run dev` health check reports which providers are on.
# ---------------------------------------------------------------------------

# --- Google Gemini (primary by default; gemini-2.5-flash → gemini-flash-latest) ---
GEMINI_API_KEY=

# --- OpenRouter (free models, text-only, auto-fallback list is built in) ---
OPENROUTER_API_KEY=

# --- Groq (free tier: openai/gpt-oss-120b etc., auto-fallback list is built in) ---
GROQ_API_KEY=

# --- Mistral (free tier: mistral-small-latest etc., auto-fallback list is built in) ---
MISTRAL_API_KEY=

# --- Router behavior ---
# Priority in which to try providers. Comma-separated; unconfigured ones are skipped.
# Default: gemini,openrouter,groq,mistral
AI_PROVIDER_ORDER=gemini,openrouter,groq,mistral
# How long (ms) a provider is skipped after an outage-class failure (default 15000).
AI_PROVIDER_COOLDOWN_MS=15000